<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>My Profile | Getting Started with Fingerprint</title>
    <link rel="icon" href="/images/favicon.ico" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-100 min-h-screen flex flex-col">
    <!-- Navigation Header -->
    <header class="bg-white shadow">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex items-center justify-between"
      >
        <div class="flex items-center">
          <img
            class="h-10 w-10 rounded-full"
            src="/images/avatar.jpg"
            alt="User Avatar"
          />
          <span class="ml-3 font-bold text-xl text-gray-800"
            ><%= username.charAt(0).toUpperCase() + username.slice(1) %></span
          >
        </div>
        <nav class="space-x-4">
          <a href="#" class="text-gray-600 hover:text-gray-800">Home</a>
          <a href="#" class="text-gray-600 hover:text-gray-800">Profile</a>
          <a href="#" class="text-gray-600 hover:text-gray-800">Settings</a>
          <a href="/logout" class="text-red-600 hover:text-red-800">Logout</a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main
      class="flex-grow max-w-7xl mx-auto mt-6 px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-start"
    >
      <!-- Feed Column -->
      <div
        class="w-full lg:w-2/3 bg-white shadow rounded-lg px-4 sm:px-6 lg:px-8 py-6 mr-0 lg:mr-4 mb-6 lg:mb-0"
      >
        <h2 class="text-2xl font-bold mb-4">Your Feed</h2>
        <div class="divide-y divide-gray-200">
          <!-- Post 1 -->
          <div class="py-6">
            <div class="flex items-center mb-2">
              <img
                class="h-10 w-10 rounded-full"
                src="/images/avatar1.jpg"
                alt="John Doe"
              />
              <div class="ml-3">
                <p class="text-sm font-semibold text-gray-800">John Doe</p>
                <p class="text-xs text-gray-500">2 hours ago</p>
              </div>
            </div>
            <p class="text-gray-700">
              Just had the best coffee in town! Check out my latest post on new
              cafes.
            </p>
          </div>
          <!-- Post 2 -->
          <div class="py-6">
            <div class="flex items-center mb-2">
              <img
                class="h-10 w-10 rounded-full"
                src="/images/avatar2.jpg"
                alt="Jane Smith"
              />
              <div class="ml-3">
                <p class="text-sm font-semibold text-gray-800">Jane Smith</p>
                <p class="text-xs text-gray-500">3 hours ago</p>
              </div>
            </div>
            <p class="text-gray-700">
              Enjoying a sunny day at the park with friends. Life is good!
            </p>
          </div>
          <!-- Post 3 -->
          <div class="py-6">
            <div class="flex items-center mb-2">
              <img
                class="h-10 w-10 rounded-full"
                src="/images/avatar3.jpg"
                alt="Alex Johnson"
              />
              <div class="ml-3">
                <p class="text-sm font-semibold text-gray-800">
                  Maxwell Johnson
                </p>
                <p class="text-xs text-gray-500">5 hours ago</p>
              </div>
            </div>
            <p class="text-gray-700">
              Just posted a new blog on my website. Go check it out for some
              cool insights.
            </p>
          </div>
        </div>
      </div>

      <!-- Profile Info Column -->
      <div
        class="w-full lg:w-1/3 bg-white shadow rounded-lg px-4 sm:px-6 lg:px-8 py-6"
      >
        <div class="flex flex-col items-center">
          <img
            class="h-32 w-32 rounded-full"
            src="/images/avatar.jpg"
            alt="Profile Image"
          />
          <h3 class="mt-4 text-xl font-bold text-gray-800">
            <%= username.charAt(0).toUpperCase() + username.slice(1) %>
          </h3>
          <p class="mt-2 text-gray-600 text-center">
            Bio: Lorem ipsum dolor sit amet, consectetur adipiscing elit.
            Vivamus lacinia odio vitae vestibulum.
          </p>
          <div class="mt-4 space-x-2">
            <a href="#" class="text-gray-600 hover:text-gray-900"
              >View Friends</a
            >
            <a href="#" class="text-gray-600 hover:text-gray-900">Photos</a>
            <a href="#" class="text-gray-600 hover:text-gray-900">Settings</a>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <!-- <footer class="bg-white shadow py-4">
      <div class="max-w-7xl mx-auto px-4 text-center text-gray-600">
        <p>&copy; 2025 It's a demo</p>
      </div>
    </footer> -->
  </body>
</html>
